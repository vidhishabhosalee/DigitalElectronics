library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity full_subtractor is
    Port ( A : in STD_LOGIC;
           B : in STD_LOGIC;
           Bin : in STD_LOGIC;
           Diff : out STD_LOGIC;
           Bout : out STD_LOGIC);
end full_subtractor;

architecture Dataflow of full_subtractor is

begin
    Diff <= A xor B xor Bin;
    Bout <= ((not A) and B) or ((A xnor B) and Bin);
    

end Dataflow;
