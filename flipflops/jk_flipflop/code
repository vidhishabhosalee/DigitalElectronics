library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity jk_flipflop is
    Port ( J : in STD_LOGIC;
           K : in STD_LOGIC;
           CLK : in STD_LOGIC;
           Q : out STD_LOGIC;
           Qbar : out STD_LOGIC);
end jk_flipflop;

architecture dataflow of jk_flipflop is

    signal temp : STD_LOGIC := '0';

begin

    temp <= (J AND NOT temp) OR (NOT K AND temp)
            WHEN rising_edge(CLK);

    Q <= temp;
    Qbar <= NOT temp;

end dataflow;
