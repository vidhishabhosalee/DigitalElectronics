library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity sr_flipflop is
    Port ( S : in STD_LOGIC;
           R : in STD_LOGIC;
           CLK : in STD_LOGIC;
           Q : out STD_LOGIC;
           Qbar : out STD_LOGIC);
end sr_flipflop;

architecture dataflow of sr_flipflop is

    signal temp : STD_LOGIC := '0';

begin

    temp <= (S OR temp) AND (NOT R)
            WHEN rising_edge(CLK);

    Q <= temp;
    Qbar <= NOT temp;

end dataflow;
