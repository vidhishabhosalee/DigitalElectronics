library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
entity half_adder is
    Port ( A : in STD_LOGIC;
           B : in STD_LOGIC;
           Sum : out STD_LOGIC;
           Carry : out STD_LOGIC);
end half_adder;

architecture Behavioral of half_adder is

begin
    process(A,B)
    begin
        if(A = '1' and B = '1') then
           Sum <= '0';
           Carry <= '1';
        elsif(A = '0' and B = '0') then
           Sum <= '0';
           Carry <= '0';
        else 
           Sum <= '1';
           Carry <= '0';
        end if;
    end process;
end Behavioral;
