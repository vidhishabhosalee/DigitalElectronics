library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity dataflow_halfadder is
    Port ( A : in STD_LOGIC;
           B : in STD_LOGIC;
           Sum : out STD_LOGIC;
           Carry : out STD_LOGIC);
end dataflow_halfadder;

architecture Dataflow of dataflow_halfadder is

begin
     Sum <= A xor B;
     Carry <= A and B;

end Dataflow;
